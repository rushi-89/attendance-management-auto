PORT=8000
FRONTEND_ORIGIN=http://localhost:5173
MAX_UPLOAD_MB=10
# Optional absolute path to the Python executable used by the backend.
# Windows example: PYTHON_BIN=C:\path\to\smart-attendance\backend\.venv\Scripts\python.exe
# Ubuntu/macOS example: PYTHON_BIN=/absolute/path/to/smart-attendance/backend/.venv/bin/python
PYTHON_BIN=

# Email via SMTP (leave blank to disable email)
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# SMS via Twilio (leave blank to disable SMS)
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM_NUMBER=
